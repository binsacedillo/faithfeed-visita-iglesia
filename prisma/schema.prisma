generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id             String   @id @default(cuid())
  type           String
  title          String
  content        String
  author         String?
  scriptureRef   String?
  imageUrl       String?
  stationNumber  Int?
  prayerText     String?
  prayerResponse String?
  introText      String?
  outroText      String?
  category       String   @default("GENERAL")
  scheduledDay   String?
  closingPrayer  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([category])
}

model LiturgicalReading {
  id             String   @id @default(cuid())
  cycle          String   @default("ANY") // "A", "B", "C", or "ANY"
  season         String   // "ADVENT", "CHRISTMAS", "LENT", "EASTER_SEASON", "ORDINARY_TIME", "PENTECOST", etc.
  weekOfSeason   Int      // e.g., 1 to 34
  dayOfWeek      String   // "SUNDAY", "MONDAY", ..., "SATURDAY"
  isFeast        Boolean  @default(false)
  feastMonth     Int?
  feastDay       Int?
  title          String
  gospelRef      String
  gospelText     String
  reflection     String
  prayerText     String?
  prayerResponse String?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([season, weekOfSeason, dayOfWeek, cycle])
  @@index([feastMonth, feastDay])
}

